{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scryglass.xyz/schemas/model-v2/partial-draft-state.schema.json",
  "title": "Scryglass partial Draft Score analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_version",
    "as_of",
    "season_id",
    "calendar_year",
    "analysis_kind",
    "status",
    "identity_mode",
    "identity_intentionally_omitted",
    "lineage",
    "provenance"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/semver"},
    "model_version": {"$ref": "common.schema.json#/$defs/model_version"},
    "as_of": {"$ref": "common.schema.json#/$defs/timestamp"},
    "season_id": {"$ref": "common.schema.json#/$defs/season_id"},
    "calendar_year": {"$ref": "common.schema.json#/$defs/calendar_year"},
    "analysis_kind": {
      "type": "string",
      "enum": ["partial_draft_score", "archetype_extrapolation"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "unavailable", "research_only"]
    },
    "identity_mode": {"$ref": "common.schema.json#/$defs/identity_mode"},
    "identity_intentionally_omitted": {"type": "boolean"},
    "baseline_strength_equalized": {"type": "boolean"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_state_id",
        "event_id",
        "competition_scope_id",
        "competition_scope_kind",
        "patch_id",
        "protocol_id",
        "side_mapping",
        "source_record",
        "side_to_act",
        "actions",
        "current_role_constraints",
        "role_constraint_revisions",
        "assignment_revisions",
        "terminal"
      ],
      "properties": {
        "draft_state_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "event_id": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/stable_id"},
            {"type": "null"}
          ]
        },
        "competition_scope_id": {
          "$ref": "common.schema.json#/$defs/stable_id",
          "description": "Canonical league or named international event/meta scope used for calibration; never inferred from a participating team's domestic league."
        },
        "competition_scope_kind": {
          "type": "string",
          "enum": [
            "regional_league",
            "international_event",
            "international_meta"
          ]
        },
        "patch_id": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "protocol_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "side_mapping": {
          "$ref": "common.schema.json#/$defs/draft_protocol_mapping"
        },
        "source_record": {
          "$ref": "common.schema.json#/$defs/draft_source_record"
        },
        "side_to_act": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/side"},
            {"type": "null"}
          ]
        },
        "actions": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/draft_action"}
        },
        "current_role_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/role_constraint"}
        },
        "role_constraint_revisions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/role_constraint_revision"
          },
          "x-history-policy": {
            "append_only": true,
            "order_by": "revision_index",
            "chain_field": "supersedes_revision_id"
          }
        },
        "assignment_revisions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/role_assignment_revision"
          },
          "x-history-policy": {
            "append_only": true,
            "order_by": "revision_index",
            "chain_field": "supersedes_revision_id"
          }
        },
        "terminal": {"type": "boolean"},
        "final_assignments": {
          "$ref": "common.schema.json#/$defs/terminal_assignments"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"terminal": {"const": true}},
            "required": ["terminal"]
          },
          "then": {
            "properties": {"side_to_act": {"type": "null"}},
            "required": ["final_assignments"]
          },
          "else": {
            "properties": {
              "side_to_act": {"$ref": "common.schema.json#/$defs/side"}
            },
            "not": {"required": ["final_assignments"]}
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roster_a_id", "roster_b_id"],
      "properties": {
        "roster_a_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "roster_b_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "roster_a_snapshot_id": {
          "$ref": "common.schema.json#/$defs/stable_id"
        },
        "roster_b_snapshot_id": {
          "$ref": "common.schema.json#/$defs/stable_id"
        },
        "policy_a_snapshot_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "policy_b_snapshot_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "roster_a_fresh": {"type": "boolean"},
        "roster_b_fresh": {"type": "boolean"},
        "policy_a_fresh": {"type": "boolean"},
        "policy_b_fresh": {"type": "boolean"}
      }
    },
    "committed_value_logit_a": {"type": "number"},
    "strategic_response_adjustment_logit_a": {
      "type": "number",
      "description": "Signed change from committed value induced by the registered future-response policy; it may be negative."
    },
    "strategic_value_logit_a": {"type": "number"},
    "partial_score_a": {"$ref": "common.schema.json#/$defs/score_open_100"},
    "partial_score_b": {"$ref": "common.schema.json#/$defs/score_open_100"},
    "standardized_map_win_probability_a": {
      "$ref": "common.schema.json#/$defs/probability_open"
    },
    "interval_95": {"$ref": "common.schema.json#/$defs/interval_probability_95"},
    "flex_value_logit_a": {"type": "number"},
    "evidence": {"$ref": "common.schema.json#/$defs/evidence"},
    "reliability": {"$ref": "common.schema.json#/$defs/reliability"},
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "method",
        "temperature",
        "exact",
        "explored_state_count",
        "coverage",
        "deterministic_seed"
      ],
      "properties": {
        "policy_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "method": {
          "type": "string",
          "enum": ["hard_minimax", "soft_minimax", "empirical_policy", "risk_aware"]
        },
        "temperature": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "null"}
          ]
        },
        "exact": {"type": "boolean"},
        "explored_state_count": {"type": "integer", "minimum": 1},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric_id", "value"],
          "properties": {
            "metric_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "value": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "approximation_error_bound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_id", "value_logit"],
          "properties": {
            "method_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "value_logit": {"type": "number", "minimum": 0}
          }
        },
        "deterministic_seed": {"type": "integer"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"exact": {"const": false}},
            "required": ["exact"]
          },
          "then": {
            "required": ["approximation_error_bound"],
            "properties": {
              "coverage": {
                "properties": {
                  "value": {"exclusiveMinimum": 0, "maximum": 1}
                }
              }
            }
          },
          "else": {
            "properties": {
              "coverage": {
                "properties": {"value": {"const": 1}}
              }
            },
            "not": {"required": ["approximation_error_bound"]}
          }
        }
      ],
      "x-semantic-invariants": [
        {
          "id": "partial_approximate_search_reports_coverage_and_bound",
          "applies_when": "exact == false",
          "expression": "coverage.value > 0 && approximation_error_bound.method_id is registered && approximation_error_bound.value_logit >= 0",
          "severity": "error"
        },
        {
          "id": "partial_exact_search_full_coverage",
          "applies_when": "exact == true",
          "expression": "coverage.value == 1 && approximation_error_bound is absent",
          "severity": "error"
        }
      ],
      "x-negative-mutation-fixtures": [
        {
          "id": "partial_approximate_search_missing_bound",
          "mutation": {
            "op": "remove",
            "path": "/search/approximation_error_bound"
          },
          "expected_schema_failure": true
        },
        {
          "id": "partial_exact_search_partial_coverage",
          "mutation": [
            {
              "op": "replace",
              "path": "/search/exact",
              "value": true
            },
            {
              "op": "replace",
              "path": "/search/coverage/value",
              "value": 0.93
            }
          ],
          "expected_schema_failure": true
        }
      ]
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "action",
          "posterior_mean_value_change_for_acting_side_logit",
          "delta_interval_95",
          "downside_probability",
          "option_diversity",
          "best_responses"
        ],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "action": {"$ref": "common.schema.json#/$defs/draft_action"},
          "posterior_mean_value_change_for_acting_side_logit": {
            "type": "number"
          },
          "delta_interval_95": {"$ref": "common.schema.json#/$defs/interval_real_95"},
          "downside_probability": {
            "$ref": "common.schema.json#/$defs/probability_open"
          },
          "option_diversity": {"type": "number", "minimum": 0},
          "best_responses": {
            "type": "array",
            "items": {"$ref": "common.schema.json#/$defs/draft_action"}
          }
        }
      }
    },
    "neutral_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partial_score_a",
        "partial_score_b",
        "standardized_map_win_probability_a"
      ],
      "properties": {
        "partial_score_a": {
          "$ref": "common.schema.json#/$defs/score_open_100"
        },
        "partial_score_b": {
          "$ref": "common.schema.json#/$defs/score_open_100"
        },
        "standardized_map_win_probability_a": {
          "$ref": "common.schema.json#/$defs/probability_open"
        }
      }
    },
    "terminal_delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_method",
        "terminal_model_version",
        "terminal_prediction_id",
        "terminal_output_sha256",
        "score_a",
        "score_b",
        "standardized_map_win_probability_a",
        "interval_95"
      ],
      "properties": {
        "delegation_method": {"const": "canonical_terminal_draft_score"},
        "terminal_model_version": {
          "$ref": "common.schema.json#/$defs/model_version"
        },
        "terminal_prediction_id": {
          "$ref": "common.schema.json#/$defs/stable_id"
        },
        "terminal_output_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "score_a": {"$ref": "common.schema.json#/$defs/score_open_100"},
        "score_b": {"$ref": "common.schema.json#/$defs/score_open_100"},
        "standardized_map_win_probability_a": {
          "$ref": "common.schema.json#/$defs/probability_open"
        },
        "interval_95": {
          "$ref": "common.schema.json#/$defs/interval_probability_95"
        }
      }
    },
    "archetype_extrapolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extrapolation_id",
        "ordinal_only",
        "support_gap",
        "fallback",
        "uncertainty",
        "recommendation_groups"
      ],
      "properties": {
        "extrapolation_id": {"$ref": "common.schema.json#/$defs/stable_id"},
        "ordinal_only": {"const": true},
        "support_gap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "champion_id",
            "competition_scope_id",
            "competition_scope_kind",
            "patch_id",
            "role_set",
            "gap_types",
            "verified_eligible_appearance_count"
          ],
          "properties": {
            "champion_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "competition_scope_id": {
              "$ref": "common.schema.json#/$defs/stable_id"
            },
            "competition_scope_kind": {
              "type": "string",
              "enum": [
                "regional_league",
                "international_event",
                "international_meta"
              ]
            },
            "patch_id": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "role_set": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {"$ref": "common.schema.json#/$defs/role"}
            },
            "gap_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "zero_play_exact_cell",
                  "unobserved_role",
                  "unobserved_patch",
                  "unobserved_competition_scope"
                ]
              }
            },
            "verified_eligible_appearance_count": {"const": 0}
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prior_id",
            "fallback_levels",
            "basis",
            "material",
            "unsupported_exact_residuals_included",
            "limitations"
          ],
          "properties": {
            "prior_id": {"$ref": "common.schema.json#/$defs/stable_id"},
            "fallback_levels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["F2", "F3", "F4", "F5"]
              }
            },
            "basis": {
              "type": "string",
              "enum": [
                "registered_role_archetype_prior",
                "registered_role_patch_neutral_prior",
                "registered_team_player_archetype_fit_prior"
              ]
            },
            "material": {"const": true},
            "unsupported_exact_residuals_included": {"const": false},
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ordinal_stability",
            "quantitative_interval_available",
            "reasons"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["wide", "unresolved"]
            },
            "ordinal_stability": {
              "type": "string",
              "enum": ["low", "unknown"]
            },
            "quantitative_interval_available": {"const": false},
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "recommendation_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "group_order",
              "within_group_ordered",
              "actions"
            ],
            "properties": {
              "group_id": {"$ref": "common.schema.json#/$defs/stable_id"},
              "group_order": {"type": "integer", "minimum": 1},
              "within_group_ordered": {"const": false},
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/draft_action"
                }
              }
            }
          }
        }
      }
    },
    "research_interpretation": {
      "const": "Research-only ordinal archetype extrapolation for an unsupported exact cell; the output supports relative grouping only."
    },
    "literal_interpretation": {
      "type": "string",
      "enum": [
        "Out of 100, the projected standardized map-win probability for side A under the registered future-response policy, after accounting for committed picks and remaining options, equalizing baseline roster and league strength, and neutralizing in-game side advantage.",
        "Terminal draft state delegated without recomputation to canonical Terminal Draft Score for identical inputs and terminal model version."
      ]
    },
    "error": {"$ref": "common.schema.json#/$defs/error"},
    "lineage": {"$ref": "common.schema.json#/$defs/lineage"},
    "provenance": {"$ref": "prediction-provenance.schema.json"}
  },
  "examples": [
