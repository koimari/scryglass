    "wave_control.siege",
    "wave_control.freeze",
    "scaling.early",
    "scaling.mid",
    "scaling.late",
    "scaling.late_spike",
    "target_access.frontline",
    "target_access.hook",
    "target_access.reposition",
    "target_access.split_push",
    "durability_frontline.squishy",
    "durability_frontline.frontline",
