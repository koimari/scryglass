    "effective_range.long",
    "engage.none",
    "engage.single",
    "engage.area",
    "engage.hard",
    "peel.none",
    "peel.defensive",
    "peel.forced",
    "peel.zone",
    "mobility.low",
    "mobility.moderate",
    "mobility.high",
    "wave_control.trade",
