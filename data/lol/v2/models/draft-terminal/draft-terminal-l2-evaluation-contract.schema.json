{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scryglass:draft-terminal-l2-evaluation-contract-schema:v1",
  "title": "Draft Score independent L2 evaluation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "production_eligible",
    "public_probability_authorized",
    "estimand",
    "neutral_policy",
    "contextual_policy",
    "source_policy",
    "dependence_clusters",
    "fold_policy",
    "holdouts",
    "calibration_policy",
    "replay_policy",
    "promotion_gates",
    "g1_contextual_gate",
    "grid_promotion_gate"
  ],
  "properties": {
    "schema_version": {"const": "scryglass:draft-terminal-l2-evaluation-contract:v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "status": {"const": "pending_independent_authority"},
    "production_eligible": {"const": false},
    "public_probability_authorized": {"const": false},
    "estimand": {"type": "string", "minLength": 1},
    "neutral_policy": {"type": "object"},
    "contextual_policy": {"type": "object"},
    "source_policy": {"type": "object"},
    "dependence_clusters": {"type": "object"},
    "fold_policy": {"type": "object"},
    "holdouts": {"type": "object"},
    "calibration_policy": {"type": "object"},
    "replay_policy": {"type": "object"},
    "promotion_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "g1_contextual_gate": {"type": "object"},
    "grid_promotion_gate": {"type": "object"}
  }
}
