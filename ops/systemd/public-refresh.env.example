# Copy to /etc/scryglass/public-refresh.env on the refresh host.
# Keep values out of the repository. This file contains names only.

SCRYGLASS_PUBLIC_RELEASE=1
SCRYGLASS_PUBLISH_ORIGIN=https://scryglass.xyz
SCRYGLASS_PUBLICATION_BACKEND=supabase
SCRYGLASS_SUPABASE_URL=https://<project-ref>.supabase.co
SCRYGLASS_SUPABASE_SECRET_KEY=<supabase_worker_secret_key>
SCRYGLASS_DATA_PUBLISH_TOKEN=<production_data_publish_token>
SCRYGLASS_REFRESH_ATTEMPTS=3
SCRYGLASS_STEP_TIMEOUT_MINUTES=15
SCRYGLASS_STALE_AFTER_HOURS=12
