[Unit]
Description=Scryglass six-hour public refresh
After=network-online.target
Wants=network-online.target
OnFailure=scryglass-public-refresh-alert@%n.service

[Service]
Type=oneshot
User=scryglass
Group=scryglass
WorkingDirectory=/srv/scryglass/current
EnvironmentFile=/etc/scryglass/public-refresh.env
Environment=SCRYGLASS_PUBLIC_RELEASE=1
ExecStartPre=/srv/scryglass/current/ops/verify-public-refresh-env.sh /srv/scryglass/current /srv/scryglass/venv
ExecStart=/srv/scryglass/venv/bin/python -m lol_kills.public_refresh --root /srv/scryglass/current --public-root /srv/scryglass-data/public-packs --once
TimeoutStartSec=55min
Nice=10
PrivateTmp=true
NoNewPrivileges=true
